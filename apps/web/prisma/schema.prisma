generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StoreSettings {
  id          Boolean  @id @default(true)
  revision    Int      @default(0)
  initialized Boolean  @default(false)
  shipping    Json     @default("{}")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("essen_store_settings")
}

model Product {
  id          BigInt          @id
  sku         String
  name        String
  category    String
  price       Decimal         @db.Decimal(12, 2)
  compareAt   Decimal?        @map("compare_at") @db.Decimal(12, 2)
  color       String
  image       String
  tag         String          @default("")
  description String
  occasion    String?
  fabric      String?
  active      Boolean         @default(false)
  featured    Boolean         @default(false)
  isNew       Boolean         @default(false) @map("is_new")
  variants    ProductVariant[]
  movements   StockMovement[]

  @@map("essen_products")
}

model ProductVariant {
  productId BigInt  @map("product_id")
  size      String
  quantity  Int     @default(0)
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, size])
  @@map("essen_product_variants")
}

model StockMovement {
  id             String   @id
  productId      BigInt   @map("product_id")
  productName    String   @map("product_name")
  size           String
  beforeQuantity Int      @map("before_quantity")
  afterQuantity  Int      @map("after_quantity")
  reason         String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurredAt(sort: Desc)], map: "essen_movements_time")
  @@map("essen_stock_movements")
}

model Shipment {
  id          String   @id
  reference   String
  recipient   String
  destination String
  service     String
  status      String
  tracking    String   @default("")
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@map("essen_shipments")
}

model Admin {
  id     Boolean @id @default(true)
  salt   String
  hash   String
  secret String

  @@map("essen_admin")
}
